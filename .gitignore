# Ignore environment variables file
.env

# Ignore the 'other' folder and all its contents
other/

# Ignore Python cache files and folders
__pycache__/
*.pyc

# Ignore the venv virtual environment folder
venv_uniswap_swapper/

# Ignore macOS system files
.DS_Store

# Ignore log and data files (optional, but recommended)
*.log
*.txt
*.json
# To keep specific json or txt files, add a '!' before them
!target_pools_Dex.json
!hot_pools.json
!token_mapping.json
!requirements.txt
!ABI/*.json

# Ignore all contents of the data directory used for backtesting
data/
!data/.gitkeep
state.json

# 忽略所有 node_modules
node_modules/

# 如果有子資料夾 (dashboard/backend, dashboard/frontend) 也會一起忽略
dashboard/backend/node_modules/
dashboard/frontend/node_modules/
